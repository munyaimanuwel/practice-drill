# Database
DATABASE_URL=postgresql://drill:drill@localhost:5432/interview_drill?schema=public

# Auth
# Generate a long random string for production
AUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Seed admin user
SEED_USER_EMAIL=manuwel@local.dev
SEED_USER_PASSWORD=change-me-now
SEED_USER_NAME=Manuwel

# Optional: create sessions without browser admin (Hermes cron later)
SESSION_CREATE_TOKEN=change-me-session-create-token

# Files
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=20971520

# Optional: `npm run session:create` CLI (env-driven)
# CREATE_TYPE=quiz|code
# CREATE_TITLE=My session
# CREATE_SUMMARY=One-liner
# CREATE_TAGS=csharp,docker
# CREATE_DIFFICULTY=3
# CREATE_MINUTES=45
# CREATE_WHEN=2026-08-01T18:30:00+02:00
# CREATE_STATUS=ready
# CREATE_PAYLOAD={"questions":[]}
