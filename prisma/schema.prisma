generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionType {
  quiz
  code
}

enum SessionStatus {
  draft
  ready
  in_progress
  submitted
  grade_requested
  graded
  cancelled
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  sessions     DrillSession[]
}

model DrillSession {
  id                String        @id @default(uuid()) @db.Uuid
  type              SessionType
  status            SessionStatus @default(draft)
  title             String
  summary           String?
  topicTags         String[]
  difficulty        Int           @default(3)
  timeLimitMinutes  Int           @default(45)
  scheduledFor      DateTime?
  payload           Json
  answerPayload     Json?
  starterPath       String?
  submissionPath    String?
  score             Float?
  feedback          String?
  gradeRubricNotes  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  openedAt          DateTime?
  submittedAt       DateTime?
  gradedAt          DateTime?
  userId            String        @db.Uuid
  user              User          @relation(fields: [userId], references: [id])

  @@index([userId, status, scheduledFor])
  @@index([status, createdAt])
}
